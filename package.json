{
  "name": "arbo-ocr-js",
  "version": "0.3.1",
  "description": "OCR for Node.js and Bun — extract text and layout from images and scanned documents. Zero dependencies, no native build, optional CUDA/TensorRT.",
  "license": "Apache-2.0",
  "author": "wafik",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARBO-TEAM/arbo-ocr-js.git"
  },
  "bugs": {
    "url": "https://github.com/ARBO-TEAM/arbo-ocr-js/issues"
  },
  "homepage": "https://arbo-team.github.io/arbo-ocr-docs/latest/wrappers/js/",
  "keywords": [
    "ocr",
    "onnx",
    "onnxruntime",
    "paddleocr",
    "pp-ocrv6",
    "text-recognition",
    "text-detection",
    "document-ai",
    "bun",
    "typescript"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
